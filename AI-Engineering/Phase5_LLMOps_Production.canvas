		{"id":"grp_test","type":"group","x":370,"y":-40,"width":340,"height":1100,"label":"🧪 LLM Testing & Optimization"},
		{
			"id":"a_hub",
			"type":"text",
			"text":"🧪 LLM Testing\n& Automated Optimization",
			"styleAttributes":{},
			"x":410,
			"y":0,
			"width":260,
			"height":90,
			"color":"#ec4899"
		},
		{
			"id":"a_dspy",
			"type":"text",
			"text":"🔷 DSPy Prompt Compiler\n— Replace hand-written prompts\n— dspy.Predict, ChainOfThought\n— BootstrapFewShot optimizer\n— MIPROv2: instruction search",
			"styleAttributes":{},
			"x":410,
			"y":120,
			"width":260,
			"height":110,
			"color":"#ec4899"
		},
		{
			"id":"a_auto_tune",
			"type":"text",
			"text":"◈ Automated Prompt Tuning\n— Metric function definition\n— Training set construction\n— Search over prompt space\n— Optimal few-shot auto-find",
			"styleAttributes":{},
			"x":410,
			"y":260,
			"width":260,
			"height":100,
			"color":"#ec4899"
		},
		{
			"id":"a_langtest",
			"type":"text",
			"text":"◈ LangTest Framework\n— Harness for robustness tests\n— Bias, fairness, accuracy suites\n— augment() adversarial gen\n— run() batch evaluation",
			"styleAttributes":{},
			"x":410,
			"y":390,
			"width":260,
			"height":100,
			"color":"#ec4899"
		},
		{
			"id":"a_giskard",
			"type":"text",
			"text":"◈ Giskard Vulnerability\n— LLM vulnerability scanner\n— Hallucination detection\n— Prompt injection testing\n— Stereotype / PII leakage",
			"styleAttributes":{},
			"x":410,
			"y":520,
			"width":260,
			"height":100,
			"color":"#ec4899"
		},
		{
			"id":"a_unit",
			"type":"text",
			"text":"◈ Unit Testing LLM Outputs\n— pytest + LLM-as-judge\n— deepeval assertion framework\n— Golden dataset regression\n— Deterministic: temperature=0",
			"styleAttributes":{},
			"x":410,
			"y":650,
			"width":260,
			"height":100,
			"color":"#ec4899"
		},
		{
			"id":"a_ab",
			"type":"text",
			"text":"◈ A/B Testing Prompts\n— Traffic split across variants\n— Statistical significance test\n— Champion/challenger promo\n— Math: t-test, p-value < 0.05",
			"styleAttributes":{},
			"x":410,
			"y":780,
			"width":260,
			"height":100,
			"color":"#ec4899"
		},
		{
			"id":"a_finetune_eval",
			"type":"text",
			"text":"◈ Fine-Tune Evaluation\n— BLEU, ROUGE metrics\n— Human eval vs auto-eval\n— Held-out test set design\n— Catastrophic forgetting check",
			"styleAttributes":{},
			"x":410,
			"y":910,
			"width":260,
			"height":90,
			"color":"#ec4899"
		},
		{
			"id":"a_math_test",
			"type":"text",
			"text":"🔷 Evaluation Math\n— Precision = TP/(TP+FP)\n— Recall = TP/(TP+FN)\n— F1 = 2·P·R/(P+R)\n— NDCG for ranked retrieval",
			"styleAttributes":{},
			"x":410,
			"y":1020,
			"width":260,
			"height":80,
			"color":"#6c3483"
		},
