			"x": 410,
			"y": 650,
			"width": 260,
			"height": 100,
			"color": "#3498db"
		},
		{
			"id": "a_phidata",
			"type": "text",
			"text": "◈ Phidata Agents\n— Agent(model, tools, storage, memory)\n— Built-in web/file/code tools\n— Declarative agent definition\n— Team orchestration support",
