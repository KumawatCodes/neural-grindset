			"height": 90,
			"color": "#3498db"
		},
		{
			"id": "a_react",
			"type": "text",
			"text": "🔷 ReAct Framework\n— Thought → Action → Observation\n— Tool-grounded reasoning\n— Iterative refinement cycle\n— Paper: Yao et al. 2022",
			"styleAttributes": {},
			"x": 410,
			"y": 120,
			"width": 260,
			"height": 110,
			"color": "#3498db"
		},
		{
			"id": "a_plansolve",
			"type": "text",
			"text": "◈ Plan-and-Solve\n— Phase 1: explicit plan generation\n— Phase 2: sequential execution\n— Reduces lost-in-middle failures\n— Plan tracking state variable",
			"styleAttributes": {},
			"x": 410,
			"y": 260,
			"width": 260,
			"height": 100,
			"color": "#3498db"
		},
		{
			"id": "a_reflection",
			"type": "text",
			"text": "🔷 Reflection & Self-Critique\n— Agent critiques own output\n— Gap identification loop\n— Reflexion paper architecture\n— Score-threshold re-attempt",
			"styleAttributes": {},
			"x": 410,
			"y": 390,
			"width": 260,
			"height": 100,
			"color": "#3498db"
		},
		{
			"id": "a_selfcorrect",
			"type": "text",
			"text": "◈ Self-Correction\n— LLM-as-judge self-scoring\n— Rewrite below-threshold\n— Max retry ceiling\n— Escalate to human if fail",
			"styleAttributes": {},
			"x": 410,
			"y": 520,
			"width": 260,
			"height": 100,
			"color": "#3498db"
		},
		{
			"id": "a_cot_agent",
			"type": "text",
			"text": "◈ CoT in Agents\n— Chain-of-thought as scratchpad\n— Internal monologue pattern\n— Structured reasoning traces\n— Tree-of-Thought search",
