		{"id":"grp_llmops","type":"group","x":20000,"y":-600,"width":2600,"height":2680,"color":"6","label":"🟣 Phase 5 — Production LLMOps, Testing, Security & Evaluation"},
		{"id":"grp_rag","type":"group","x":5000,"y":-600,"width":2600,"height":2470,"color":"2","label":"🟡 Phase 2 — Advanced Retrieval & RAG Architectures"},
