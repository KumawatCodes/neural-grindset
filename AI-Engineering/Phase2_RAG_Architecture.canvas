			"height":90,
			"color":"#1abc9c"
		},
		{
			"id":"b_agentic",
			"type":"text",
			"text":"◈ Agentic / LLM Chunking\n— LLM determines split points\n— Proposition-based chunking\n— Atomic fact extraction\n— Dense X retrieval",
